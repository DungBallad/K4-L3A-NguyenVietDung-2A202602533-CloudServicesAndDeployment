# File này quyết định thứ KHÔNG được copy vào image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.

# Secret
.env
.env.*
!.env.example

# Git & CI
.git
.gitignore
.github

# Python
__pycache__
*.py[cod]
.venv
venv
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

